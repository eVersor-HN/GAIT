# Copy to keystore.properties (gitignored) and fill in. Used only by the `release` build type.
#
# Create the keystore once (keep it and these passwords safe -- losing them means you can
# never update the app on the Play Store again):
#
#   keytool -genkeypair -v -keystore gait-release.jks -alias gait -keyalg RSA -keysize 4096 -validity 10000
#
# Paths are resolved relative to the repository root.
storeFile=gait-release.jks
storePassword=
keyAlias=gait
keyPassword=
