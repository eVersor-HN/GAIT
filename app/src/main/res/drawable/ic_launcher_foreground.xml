<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a G cut from a stride — one open ring with a hard horizontal bar, drawn on the
  grid. Flat, monochrome, no gradients, no depth. Reads at 24 dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- open ring: G bowl, gap on the right -->
    <path
        android:strokeColor="#FFF1F2F3"
        android:strokeWidth="7"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"
        android:pathData="M69.5,42.5 A19.5,19.5 0 1,0 69.5,65.5" />
    <!-- the bar of the G -->
    <path
        android:fillColor="#FFF1F2F3"
        android:pathData="M54,50.5 h16 v7 h-16 z" />
    <!-- stride tick: the asset moving right -->
    <path
        android:fillColor="#FFD8A62A"
        android:pathData="M69.5,62 h4.5 v7 h-4.5 z" />
</vector>
