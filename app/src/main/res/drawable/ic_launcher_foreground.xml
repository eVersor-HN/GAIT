<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground. Three ascending brass strides (chevrons), gait as motion,
  crossed by one faint cyan scanline, on the app's ink background. All geometry sits well
  inside the 66dp safe circle so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- scanline -->
    <path
        android:pathData="M30,54 L78,54"
        android:strokeColor="#49C9C2"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round" />

    <!-- stride 1 (lowest, dimmest) -->
    <path
        android:pathData="M36,70 L46,60 L36,50"
        android:strokeColor="#8A7028"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- stride 2 -->
    <path
        android:pathData="M48,68 L58,58 L48,48"
        android:strokeColor="#C9A227"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- stride 3 (leading, brightest) -->
    <path
        android:pathData="M60,66 L70,56 L60,46"
        android:strokeColor="#E9E4D8"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
